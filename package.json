{
  "name": "loudbox",
  "productName": "Loudbox",
  "version": "1.2.0",
  "description": "A music player that plays YouTube videos as songs.",
  "author": "Loudbox",
  "main": "electron-main.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "app.loudbox.player",
    "productName": "Loudbox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "electron-preload.js",
      "youtube.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Loudbox",
      "artifactName": "Loudbox-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Loudbox-Portable-${version}.${ext}"
    },
    "afterPack": "build/afterPack.js"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "rcedit": "^4.0.1"
  },
  "allowScripts": {
    "electron@33.2.1": true
  }
}
